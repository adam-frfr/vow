# Copy to .env and fill in. Only these three live here: everything else
# (Groq, Stripe, Backblaze, maintenance, sign-ups...) is set in /admin.

# Supabase → Project → Connect → ORMs → Prisma.
# Pooled connection (port 6543) for the app:
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session pooler (port 5432) for migrations:
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Signs logins and encrypts the keys you save in /admin. Generate once, never change:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Local development without Supabase: `npx prisma dev` starts a local Postgres;
# use the URL it prints for both DATABASE_URL (add &pgbouncer=true) and DIRECT_URL.

// SQLite for local development. To go to production, switch provider to
// "postgresql" and point DATABASE_URL at Postgres (Supabase, Neon, RDS...).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  /// Can open /admin. Also granted by ADMIN_EMAILS in .env.
  isAdmin      Boolean  @default(false)
  /// Blocked accounts cannot sign in; their published sites go offline.
  blocked      Boolean  @default(false)
  lastLoginAt  DateTime?
  sites        Site[]
}

/// Every sign-in attempt (for the admin's activity and abuse views).
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  ok        Boolean
  /// Salted hash of the IP: enough to spot abuse, without storing the address.
  ipHash    String
  userAgent String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ipHash])
}

/// Abuse signals: rate-limit hits, honeypot catches, AI-flagged spam, blocked logins.
model SecurityEvent {
  id        String   @id @default(cuid())
  kind      String
  scope     String   @default("")
  ipHash    String
  siteId    String?
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ipHash])
}

/// Admin-controlled settings (secrets are stored encrypted).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AiUsage {
  id        String   @id @default(cuid())
  userId    String?
  siteId    String?
  feature   String
  tokens    Int      @default(0)
  ok        Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model Payment {
  id        String   @id @default(cuid())
  siteId    String
  userId    String
  provider  String   @default("stripe")
  /// Checkout session id from the provider.
  sessionId String   @unique
  amount    Int
  currency  String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
}

model Site {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug          String   @unique
  themeId       String
  /// JSON: InviteContent (see src/lib/content.ts)
  content       String
  /// JSON: Customization overrides (colors, fonts, cover photo)
  customization String   @default("{}")
  published     Boolean  @default(false)
  /// bcrypt hash; when set, guests must enter the password to view the site
  passwordHash  String?
  /// Unlocked by payment (or granted by an admin).
  premium       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  photos        Photo[]
  rsvps         Rsvp[]
  wishes        Wish[]

  @@index([userId])
}

/// Guestbook entries left on the public site.
model Wish {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  message   String
  hidden    Boolean  @default(false)
  /// Hidden automatically by the spam filter (the couple/admin can restore it).
  flagged   Boolean  @default(false)
  ipHash    String   @default("")
  createdAt DateTime @default(now())

  @@index([siteId])
}

model Photo {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url       String
  storageKey String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([siteId])
}

model Rsvp {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  attending Boolean
  guests    Int      @default(1)
  meal      String?
  message   String?
  createdAt DateTime @default(now())

  @@index([siteId])
}
